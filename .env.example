# ==========================================
# RepoMind AI - Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="RepoMind AI"
SECRET_KEY=repomind-secret-key-development-minimum-32-chars

# Database Configuration
# Local development default: SQLite (zero-setup)
DATABASE_URL=sqlite+aiosqlite:///./repomind.db

# Production / Docker Compose with PostgreSQL + pgvector:
# DATABASE_URL=postgresql+asyncpg://repomind:repomind_password@localhost:5432/repomind_db
# POSTGRES_USER=repomind
# POSTGRES_PASSWORD=repomind_password
# POSTGRES_DB=repomind_db

# Redis Cache & Background Jobs (Optional in local dev, enabled in docker)
# REDIS_URL=redis://localhost:6379/0

# GitHub Integration
# Optional: Set a personal access token to expand rate limits from 60 to 5,000 req/hr and access private repos
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI & LLM Provider Configuration
# Supported providers: 'auto', 'openai', 'gemini', 'ollama', 'mock'
# If no keys are provided, RepoMind AI seamlessly uses its high-speed local deterministic vector engine!
LLM_PROVIDER=auto

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama Local Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Analysis Engine Limits
MAX_REPO_SIZE_MB=100
MAX_FILE_SIZE_KB=500
MAX_INDEXED_FILES=1000
ANALYSIS_TIMEOUT_SECONDS=300

# Frontend Next.js API Base URL
# By default, uses relative path '/api/v1' proxied automatically by Next.js to BACKEND_URL
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=/api/v1
